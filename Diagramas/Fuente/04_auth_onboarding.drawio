        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="24" value="13. /token (confidential en BFF web)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#1E293B;" edge="1" parent="1" source="5" target="6">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="25" value="14. access + refresh (rotado)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#1E293B;" edge="1" parent="1" source="6" target="5">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="26" value="15. Sesión cookie httpOnly (web) o token en Keystore (móvil)" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#1E293B;" edge="1" parent="1" source="5" target="4">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="27" value="16. API con Bearer JWT" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#1E293B;" edge="1" parent="1" source="4" target="5">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="28" value="17. introspect / JWKS" style="html=1;verticalAlign=bottom;endArrow=block;edgeStyle=elbowEdgeStyle;elbow=vertical;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;strokeColor=#1E293B;" edge="1" parent="1" source="5" target="6">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="29" value="&lt;b&gt;Recomendación de flujo (OAuth 2.1 / RFC 8252 / RFC 7636)&lt;/b&gt;&lt;br&gt;• SPA y móvil son clientes públicos: siempre Authorization Code con PKCE.&lt;br&gt;• Web: BFF confidencial; el navegador no ve el refresh token (mitiga XSS).&lt;br&gt;• Móvil: AppAuth; biometría del SO desbloquea el refresh.&lt;br&gt;• Onboarding facial no sustituye al IdP: es el alta y un factor de enrolamiento.&lt;br&gt;• Step-up: transferencias sobre umbral piden OTP o re-biometría.&lt;br&gt;• Access token 5 min; refresh rotado 8 h; revocación al cerrar sesión / dispositivo." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=8;fillColor=#f8fafc;strokeColor=#64748b;fontSize=11;" vertex="1" parent="1">
        <mxGeometry x="820" y="470" width="740" height="170" as="geometry"/>
      </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
