  <diagram name="C4-3 Componentes BP" id="bp-c4-cmp-16sep">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1280" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
      <mxCell id="2" value="Figura 3. Diagrama de Componentes (C4 Nivel 3) — patrones y protocolos" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0F2744;" vertex="1" parent="1">
        <mxGeometry x="40" y="15" width="1000" height="28" as="geometry"/>
      </mxCell>
      <mxCell id="3" value="API Gateway, BFF, hexagonal en transferencias, Cache-Aside, CQRS y mTLS/JWT." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
        <mxGeometry x="40" y="42" width="800" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="4" value="Amazon API Gateway + WAF" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=32;horizontal=1;collapsible=0;html=1;rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0F2744;fontSize=13;" vertex="1" parent="1">
        <mxGeometry x="30" y="80" width="320" height="430" as="geometry"/>
      </mxCell>
      <mxCell id="5" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Authorizer JWT&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Valida firma, iss, aud, exp y scopes. Rechaza llamadas sin Bearer válido.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="4">
        <mxGeometry x="18" y="40" width="284" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="6" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Rate limit / Throttle&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Cuotas por cliente y por IP. Protege el Core en picos (sueldo, fin de mes).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="4">
        <mxGeometry x="18" y="140" width="284" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="7" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Ruteo por transacción&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Componente]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Consulta, movimiento o transferencia van a distinto servicio. Canary opcional.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="4">
        <mxGeometry x="18" y="240" width="284" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="8" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;AWS WAF + Shield&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Cloud]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;OWASP, geo y reputación. TLS 1.2+. Logs a CloudWatch.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="4">
        <mxGeometry x="18" y="330" width="284" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="9" value="BFF (Web / Móvil)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=32;horizontal=1;collapsible=0;html=1;rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0F2744;fontSize=13;" vertex="1" parent="1">
        <mxGeometry x="380" y="80" width="340" height="330" as="geometry"/>
      </mxCell>
      <mxCell id="10" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Agregador de vistas&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[BFF]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Arma el DTO que necesita cada canal. Evita chatty calls desde el front.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="9">
        <mxGeometry x="18" y="40" width="304" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="11" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Filtro de auditoría&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Interceptor]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Emite evento de cada acción de negocio (quién, qué, cuándo, canal, IP).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="9">
        <mxGeometry x="18" y="130" width="304" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="12" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Circuit breaker&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Resilience4j]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Abre circuito hacia Core/CIF/SPI. Fallback controlado (cache o error de negocio).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="9">
        <mxGeometry x="18" y="220" width="304" height="80" as="geometry"/>
      </mxCell>
      <mxCell id="13" value="Servicio de Transferencias (hexagonal)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=32;horizontal=1;collapsible=0;html=1;rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0F2744;fontSize=13;" vertex="1" parent="1">
        <mxGeometry x="750" y="80" width="480" height="560" as="geometry"/>
      </mxCell>
      <mxCell id="14" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;API REST Transfer&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Puerto entrada]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;POST /transfers. Idempotency-Key. HTTPS interno + mTLS.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="13">
        <mxGeometry x="18" y="40" width="210" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="15" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Motor de Saga&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Orquestación]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Valida saldo → fraude → débito Core → SPI si aplica → notifica. Compensa si falla.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="13">
        <mxGeometry x="248" y="40" width="210" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="16" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Política de límites&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Dominio]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Tope por canal, horario y destinatario nuevo. No se duplica en el front.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="13">
        <mxGeometry x="18" y="155" width="210" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="17" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Outbox&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Patrón]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;El evento de auditoría/notificación se guarda en la misma TX y luego se publica.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="13">
        <mxGeometry x="248" y="155" width="210" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="18" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Adaptador Core&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[ACL / puerto salida]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;ISO 20022 o SOAP envuelto. Timeout 3s. Reintento idempotente.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="13">
        <mxGeometry x="18" y="270" width="210" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="19" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Adaptador SPI&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[ACL]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Solo transferencias interbancarias. Firma, correlativo y conciliación T+0/T+1.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="13">
        <mxGeometry x="248" y="270" width="210" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="20" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Adaptador mensajería&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[EventBridge / SQS]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Publica TransferCompleted / TransferFailed. Protocolo AWS SDK, cifrado en tránsito.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="13">
        <mxGeometry x="18" y="385" width="440" height="130" as="geometry"/>
      </mxCell>
      <mxCell id="21" value="Servicio de Clientes + cache frecuente" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=32;horizontal=1;collapsible=0;html=1;rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0F2744;fontSize=13;" vertex="1" parent="1">
        <mxGeometry x="1260" y="80" width="500" height="360" as="geometry"/>
      </mxCell>
      <mxCell id="22" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;API Consulta básica&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Puerto entrada]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;GET /customers/{id}. Primer servicio del enunciado. Datos del Core.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="21">
        <mxGeometry x="18" y="40" width="220" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="23" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Enricher de detalle&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Puerto salida]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Si el caso de uso pide más datos, llama al sistema complementario. Nunca en el happy path de saldo.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="21">
        <mxGeometry x="258" y="40" width="220" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="24" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Cache-Aside&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Redis]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Clientes frecuentes. Miss → Core → escribe cache. TTL 5 min + invalidación por evento.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="21">
        <mxGeometry x="18" y="160" width="220" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="25" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Repositorio&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Puerto persistencia]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;No expone SQL al dominio. Mapea al contrato interno (hexagonal).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="21">
        <mxGeometry x="258" y="160" width="220" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="26" value="Movimientos (CQRS lectura)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=32;horizontal=1;collapsible=0;html=1;rounded=1;whiteSpace=wrap;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=#0F2744;fontSize=13;" vertex="1" parent="1">
        <mxGeometry x="1260" y="460" width="500" height="300" as="geometry"/>
      </mxCell>
      <mxCell id="27" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;API Histórico&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Query]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Segundo servicio del enunciado. Paginado, filtros por fecha y tipo.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="26">
        <mxGeometry x="18" y="40" width="220" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="28" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Read model&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Elastic / Redis]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Proyección alimentada por eventos del Core. Evita consultas pesadas en línea.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="26">
        <mxGeometry x="258" y="40" width="220" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="29" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Sincronizador&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Consumidor de eventos]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Si el Core no emite eventos, polling controlado + CDC (AWS DMS) hacia el read-model.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#63BEF2;fontColor=#000000;align=center;arcSize=10;strokeColor=#2086C9;metaEdit=1;" vertex="1" parent="26">
        <mxGeometry x="18" y="155" width="460" height="100" as="geometry"/>
      </mxCell>
      <mxCell id="30" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;IdP OAuth 2.0&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[OIDC]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;JWKS para validar firma. mTLS opcional banco-IdP. Authorization Code + PKCE.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="30" y="900" width="250" height="130" as="geometry"/>
      </mxCell>
      <mxCell id="31" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;CloudWatch + X-Ray&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Observabilidad]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Métricas, trazas y alarmas. Auto-healing con health checks de ECS/EKS.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="300" y="900" width="250" height="130" as="geometry"/>
      </mxCell>
      <mxCell id="32" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Secrets Manager&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Secretos]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Credenciales Core/SPI rotadas. Nunca en el código ni en el front.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="570" y="900" width="250" height="130" as="geometry"/>
      </mxCell>
      <mxCell id="33" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;KMS + TLS&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Cifrado]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Datos en reposo (RDS, S3, Redis AUTH). En tránsito TLS 1.2+ / mTLS este-oeste.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="840" y="900" width="250" height="130" as="geometry"/>
      </mxCell>
      <mxCell id="34" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Notificaciones&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[SMS + Push/Email]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Dos canales. Plantillas. No bloquean la transferencia (async).&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1110" y="900" width="280" height="130" as="geometry"/>
      </mxCell>
      <mxCell id="35" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;BD Auditoría inmutable&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[WORM / append-only]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Hash encadenado opcional. Solo insert. Lectura a cumplimiento y SIEM.&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;align=center;" vertex="1" parent="1">
        <mxGeometry x="1410" y="890" width="340" height="150" as="geometry"/>
      </mxCell>
      <mxCell id="36" value="HTTPS JWT" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="5" target="10">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="37" value="mTLS REST" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="10" target="14">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="38" value="mTLS REST" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="10" target="22">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="39" value="JWKS" style="html=1;endArrow=blockThin;endFill=1;dashed=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#64748B;dashPattern=8 8;" edge="1" parent="1" source="30" target="5">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
