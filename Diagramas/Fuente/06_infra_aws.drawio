      </mxCell>
      <mxCell id="27" value="Observabilidad y auto-healing" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=32;horizontal=1;collapsible=0;html=1;rounded=1;whiteSpace=wrap;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=#064E3B;fontSize=13;" vertex="1" parent="4">
        <mxGeometry x="20" y="640" width="1080" height="140" as="geometry"/>
      </mxCell>
      <mxCell id="28" value="CloudWatch métricas y logs · X-Ray / OpenTelemetry · alarmas → reemplazo de tarea · GuardDuty · Security Hub&lt;br&gt;Synthetics cada 1 min sobre login y consulta de saldo. Si 3 fallos: failover DNS. Runbooks en SSM.&lt;br&gt;Backups Aurora continuos (PITR 35 días) + snapshot diario a región DR. S3 versión + Object Lock en auditoría." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=top;whiteSpace=wrap;fontSize=12;fontColor=#1F2937;" vertex="1" parent="27">
        <mxGeometry x="16" y="40" width="1040" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="29" value="DR  us-east-1  (pasiva caliente)" style="swimlane;fontStyle=1;align=center;verticalAlign=top;startSize=32;horizontal=1;collapsible=0;html=1;rounded=1;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;fontColor=#7C2D12;fontSize=13;" vertex="1" parent="1">
        <mxGeometry x="1170" y="80" width="560" height="520" as="geometry"/>
      </mxCell>
      <mxCell id="30" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Stack réplica (Terraform)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[IaC]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Mismos servicios en mínimo (0 o 1 tarea). Se escala al activar el plan de DR.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="29">
        <mxGeometry x="20" y="50" width="520" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="31" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Réplica Aurora global / snapshots&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Datos]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;RPO objetivo 15 min. RTO objetivo 60 min. Prueba semestral.&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;align=center;" vertex="1" parent="29">
        <mxGeometry x="20" y="155" width="520" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="32" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;S3 CRR + Object Lock&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Auditoría y evidencias]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;La evidencia no puede quedar solo en una región.&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;align=center;" vertex="1" parent="29">
        <mxGeometry x="20" y="260" width="520" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="33" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Failover&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Route 53]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Manual con aprobación + automático si región primaria inviable. Comunicación a clientes por SMS/Push.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="29">
        <mxGeometry x="20" y="365" width="520" height="90" as="geometry"/>
      </mxCell>
      <mxCell id="34" value="&lt;b&gt;Objetivos de resiliencia&lt;/b&gt;&lt;br&gt;&lt;br&gt;Disponibilidad canal: 99.9 % mensual&lt;br&gt;Multi-AZ: pérdida de 1 AZ sin corte&lt;br&gt;Auto-healing: tarea no sana se reemplaza&lt;br&gt;Degradación: consulta con cache si Core lento&lt;br&gt;Transferencia: fail-safe (no doble débito)&lt;br&gt;Secretos: rotation 30 días, menor privilegio IAM&lt;br&gt;Costo: Fargate Spot solo no crítico; Aurora serverless v2 off-peak" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1">
        <mxGeometry x="1170" y="620" width="560" height="250" as="geometry"/>
      </mxCell>
      </root>
