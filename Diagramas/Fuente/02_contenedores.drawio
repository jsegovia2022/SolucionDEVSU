<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net" modified="2026-09-16T21:28:03.671Z" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36" etag="bp-c4-con-16" version="24.7.17" type="device">
  <diagram name="C4-2 Contenedores BP" id="bp-c4-con-16sep">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1200" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
      <mxCell id="2" value="Figura 2. Diagrama de Contenedores (C4 Nivel 2)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#0F2744;" vertex="1" parent="1">
        <mxGeometry x="40" y="15" width="900" height="28" as="geometry"/>
      </mxCell>
      <mxCell id="3" value="SPA, app móvil, API Gateway, BFF, microservicios, cache, mensajería y cloud AWS." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontColor=#475569;" vertex="1" parent="1">
        <mxGeometry x="40" y="42" width="800" height="20" as="geometry"/>
      </mxCell>
      <mxCell id="4" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;SPA Banca Web&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Angular + TypeScript]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Aplicación de página única servida por CloudFront. Consultas, transferencias y pagos. No guarda secretos OAuth.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="40" y="80" width="230" height="150" as="geometry"/>
      </mxCell>
      <mxCell id="5" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;App móvil BP&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Flutter (iOS / Android)]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Canal móvil. Onboarding facial, login con clave, huella o Face ID. Usa AppAuth + PKCE.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="40" y="260" width="230" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="6" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;API Gateway&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Amazon API Gateway + WAF]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Único ingreso HTTPS. Autenticación JWT, rate-limit, ruteo por tipo de transacción y TLS 1.2+.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="340" y="160" width="240" height="170" as="geometry"/>
      </mxCell>
      <mxCell id="7" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;BFF Web / Móvil&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[API .NET / Node]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Backend for Frontend. Orquesta llamadas, oculta el modelo interno y aplica cookies httpOnly en web.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="650" y="70" width="230" height="150" as="geometry"/>
      </mxCell>
      <mxCell id="8" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;IdP (existente)&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[OAuth 2.0 / OIDC]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Producto corporativo ya disponible. Se configura: clientes, scopes, PKCE, MFA y tiempos de token.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="650" y="250" width="230" height="140" as="geometry"/>
      </mxCell>
      <mxCell id="9" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Servicio Clientes&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[REST + ACL]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Datos básicos desde Core. Si hace falta detalle, llama al sistema complementario. Cache de clientes frecuentes.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="940" y="70" width="230" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="10" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Servicio Movimientos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[REST / CQRS lectura]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Histórico y saldos. Consultas paginadas. Read-model para no saturar el Core.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1200" y="70" width="230" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="11" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Servicio Transferencias&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[REST + Saga]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Propias e interbancarias. Llama SPI u otros bancos según el tipo. Límites y fraude.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1460" y="70" width="230" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="12" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Servicio Onboarding&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[REST + Rekognition]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Alta con cédula + selfie + liveness. Crea el usuario en el IdP y habilita biometría del dispositivo.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="940" y="260" width="230" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="13" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Servicio Notificaciones&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Eventos + plantillas]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;SMS y Push/Email. Consume eventos de movimiento y de seguridad. Reintentos con DLQ.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1200" y="260" width="230" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="14" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Servicio Auditoría&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Eventos inmutables]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Registra toda acción del cliente. Persistencia append-only y envío a SIEM.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1460" y="260" width="230" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="15" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Servicio Productos&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[REST]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Cuentas, tarjetas y convenios de pago. Catálogo leído del Core con cache corto.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="940" y="450" width="230" height="150" as="geometry"/>
      </mxCell>
      <mxCell id="16" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Servicio Límites y Fraude&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Reglas + ML ligero]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Tope diario, horario, dispositivo y listas. Puede detener la transferencia antes del Core.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1200" y="450" width="230" height="150" as="geometry"/>
      </mxCell>
      <mxCell id="17" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Adaptadores Core / CIF&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Anti-Corruption Layer]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Traduce XML/ISO o SOAP del legado a contratos internos. Aísla al resto de cambios del Core.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1460" y="450" width="230" height="150" as="geometry"/>
      </mxCell>
      <mxCell id="18" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Redis&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Cache]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Clientes frecuentes, sesión y read-model de movimientos. TTL e invalidación por evento.&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;align=center;" vertex="1" parent="1">
        <mxGeometry x="40" y="680" width="200" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="19" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Aurora PostgreSQL&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[BD servicios]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Datos propios de cada bounded context (onboarding, límites, outbox). Multi-AZ.&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;align=center;" vertex="1" parent="1">
        <mxGeometry x="270" y="680" width="210" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="20" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;BD Auditoría&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Append-only]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Inmutable. Particionada por fecha. Retención según norma de Superintendencia.&lt;/font&gt;&lt;/div&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;align=center;" vertex="1" parent="1">
        <mxGeometry x="510" y="680" width="210" height="160" as="geometry"/>
      </mxCell>
      <mxCell id="21" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;EventBridge + SQS&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Mensajería]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Eventos de movimiento, notificación y auditoría. Desacopla escritores de lectores. DLQ.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0F766E;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#115E59;" vertex="1" parent="1">
        <mxGeometry x="750" y="690" width="220" height="140" as="geometry"/>
      </mxCell>
      <mxCell id="22" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;Core + Detalle cliente&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Sistemas legado]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;No se hospedan en esta solución. Se invocan desde los adaptadores con circuit breaker.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1000" y="690" width="230" height="140" as="geometry"/>
      </mxCell>
      <mxCell id="23" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;SMS / SES / FCM&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Canales de aviso]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Dos canales mínimos: SMS y Push/Email. Plantillas y registro de entrega.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1260" y="690" width="230" height="140" as="geometry"/>
      </mxCell>
      <mxCell id="24" value="&lt;font style=&quot;font-size: 14px&quot;&gt;&lt;b&gt;SPI / ACH&lt;/b&gt;&lt;/font&gt;&lt;div&gt;[Pagos]&lt;/div&gt;&lt;br&gt;&lt;div&gt;&lt;font style=&quot;font-size: 11px&quot;&gt;Liquidación interbancaria. Timeouts y conciliación al final del día.&lt;/font&gt;&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#8C8496;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#736782;metaEdit=1;" vertex="1" parent="1">
        <mxGeometry x="1520" y="690" width="230" height="140" as="geometry"/>
      </mxCell>
      <mxCell id="25" value="HTTPS + PKCE" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="4" target="6">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="26" value="HTTPS + PKCE" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="5" target="6">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="27" value="JWT / sesión" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="6" target="7">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="28" value="Auth Code + PKCE" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="7" target="8">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="29" value="ruteo" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="7" target="9">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="30" value="cache cliente" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="9" target="18">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="31" value="eventos" style="html=1;endArrow=blockThin;endFill=1;dashed=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#64748B;dashPattern=8 8;" edge="1" parent="1" source="11" target="21">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="32" value="SPI" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="11" target="24">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="33" value="legado" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="17" target="22">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="34" value="aviso" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="13" target="23">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="35" value="" style="html=1;endArrow=blockThin;endFill=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#334155;" edge="1" parent="1" source="14" target="20">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="36" value="" style="html=1;endArrow=blockThin;endFill=1;dashed=1;rounded=0;fontSize=10;fontColor=#1E293B;labelBackgroundColor=#ffffff;strokeColor=#64748B;dashPattern=8 8;" edge="1" parent="1" source="15" target="19">
        <mxGeometry relative="1" as="geometry"/>
      </mxCell>
      <mxCell id="37" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;font color=&apos;#23A2D9&apos;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Contenedor desplegable &amp;nbsp;&amp;nbsp;&lt;font color=&apos;#8C8496&apos;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Externo / legado&lt;br&gt;&lt;font color=&apos;#0F766E&apos;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Mensajería &amp;nbsp;&amp;nbsp;&lt;font color=&apos;#23A2D9&apos;&gt;&lt;b&gt;■&lt;/b&gt;&lt;/font&gt; Almacén de datos (cilindro)" style="rounded=1;whiteSpace=wrap;html=1;align=left;spacingLeft=10;spacingTop=6;fillColor=#f8fafc;strokeColor=#cbd5e1;fontSize=11;fontColor=#1F2937;" vertex="1" parent="1">
        <mxGeometry x="40" y="890" width="480" height="70" as="geometry"/>
      </mxCell>
      </root>
